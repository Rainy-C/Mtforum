<resources>
    <style name="Theme.MtForum" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#FAFAFA</item>
        <!-- Android 12+ requires a system splash window, but it need not show a
             second, enlarged M logo or an icon-background animation. -->
        <item name="android:windowSplashScreenBackground">#FAFAFA</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
